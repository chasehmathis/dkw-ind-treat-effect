marakov_bounds_t <- function( t){
x <- seq(0, 50)
Y1_bound <- ecdf_Y1_bound(x)
Y0_bound <- ecdf_Y0_bound(x-i)
argument <- cbind(Y0_bound[,2] - Y1_bound[,1], Y1_bound[,2] - Y0_bound[,1])
# pinning and make sure correct (notnonseical)
pin_l <- pmin(pmax(argument,0),1)
pin_u <- pmin(pmax(argument + 1,0),1)
pin_l[,1] <- apply(pin_l, 1, min)
pin_l[,2] <- apply(pin_l, 1, max)
pin_u[,1] <- apply(pin_u, 1, min)
pin_u[,2] <- apply(pin_u, 1, max)
l_bound <- max(pin_l)
u_bound <- min(pin_u)
res_bounds <- rbind(res_bounds, c(l_bound, u_bound, i))
return(res_bounds)
}
marakov_bounds_t(3)
