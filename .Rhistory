library(dkw)
set.seed(123)
# Generate uniform sample
n <- 200
x <- sort(runif(n))
Fhat <- ecdf(x)(x)
# Compute both band types
dkw <- dkw_band(Fhat, alpha = 0.05, n = n)
hybrid <- hybrid_band(Fhat, alpha = 0.05, m = n)
plot(x, Fhat, type = "s", lwd = 2,
ylim = c(0, 1), xlab = "x", ylab = "F(x)",
main = "DKW vs Hybrid Confidence Bands")
# DKW bands (gray dashed)
lines(x, dkw$lower, col = "gray50", lty = 2, lwd = 2)
lines(x, dkw$upper, col = "gray50", lty = 2, lwd = 2)
# Hybrid bands (red solid)
lines(x, hybrid$lower, col = "red", lwd = 2)
lines(x, hybrid$upper, col = "red", lwd = 2)
# True CDF
abline(0, 1, col = "blue", lwd = 2)
legend("bottomright",
c("ECDF", "DKW Bands", "Hybrid Bands", "True CDF"),
col = c("black", "gray50", "red", "blue"),
lty = c(1, 2, 1, 1), lwd = 2)
# Compute improvement
improvement_lower <- hybrid$lower - dkw$lower
improvement_upper <- dkw$upper - hybrid$upper
# Plot improvement
par(mfrow = c(1, 2))
plot(x, improvement_lower, type = "l",
main = "Lower Bound Improvement",
xlab = "x", ylab = "Hybrid - DKW",
col = "blue", lwd = 2)
abline(h = 0, lty = 2)
plot(x, improvement_upper, type = "l",
main = "Upper Bound Improvement",
xlab = "x", ylab = "DKW - Hybrid",
col = "red", lwd = 2)
abline(h = 0, lty = 2)
par(mfrow = c(1, 1))
# Compute individual components
delta <- 0.05 / 8  # Used internally
# Just show the hybrid result
plot(x, Fhat, type = "s", lwd = 2,
ylim = c(0, 1), main = "Hybrid Band Components")
# Show hybrid bounds
lines(x, hybrid$lower, col = "blue", lwd = 2)
lines(x, hybrid$upper, col = "red", lwd = 2)
# Show where DKW is used vs specialized methods
lines(x, hybrid$lower_dkw, col = "blue", lty = 3)
lines(x, hybrid$upper_dkw, col = "red", lty = 3)
legend("bottomright",
c("ECDF", "Hybrid Lower", "Hybrid Upper", "DKW (for reference)"),
col = c("black", "blue", "red", "gray"),
lty = c(1, 1, 1, 3), lwd = 2)
# Large sample comparison
n <- 1000
x <- sort(runif(n))
Fhat <- ecdf(x)(x)
dkw <- dkw_band(Fhat, alpha = 0.05, n = n)
hybrid <- hybrid_band(Fhat, alpha = 0.05, m = n)
# Average band width
cat("DKW average width:", round(mean(dkw$upper - dkw$lower), 4), "\n")
cat("Hybrid average width:", round(mean(hybrid$upper - hybrid$lower), 4), "\n")
cat("Improvement:", round(1 - mean(hybrid$upper - hybrid$lower) /
mean(dkw$upper - dkw$lower), 2) * 100, "%\n")
