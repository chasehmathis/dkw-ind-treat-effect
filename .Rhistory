bounds <- result$bounds
data <- result$data
obs_Y1 <- sort(result$obs_Y1)
obs_Y0 <- sort(result$obs_Y0)
Z <- data$Z
ATE <- mean(obs_Y1) - mean(obs_Y0)
# Compute Makarov bounds for all t values
cat("Computing Makarov bounds for all quantiles...\n")
diff_bounds <- get_marakov_bounds_all_t(bounds, obs_Y1, obs_Y0, data)
quant_true <- quantile(data$tau, 0.5)
conf.int.riqite <- RIQITE::ci_quantile(Z, data$Y, k.vec = 0.5)
conf.int.us <- diff_bounds[which(diff_bounds[,1] < 0.5 & diff_bounds[,2] > 0.5),3]
conf.int.us <- list(lower = min(conf.int.us), upper = max(conf.int.us))
width.us <- conf.int.us$upper - conf.int.us$lower
width.riqite <- conf.int.riqite$upper  - conf.int.riqite$lower
cover_us <-  quant_true> conf.int.us$lower & quant_true < conf.int.us$upper
cover_riqite <- quant_true > conf.int.riqite$lower & quant_true < conf.int.riqite$upper
return(cover_us, cover_riqite, width.us, width.riqite)
}
m <- c(1e2, 5e2, 1e3)
for(size in m){
params <- list(
m = size,     # Sample size
p = 0.5,      # Probability parameter
alpha = 0.1,   # Significance level
heterogeneity = 3,
outcome_model = rlnorm,
tight_bounds = T
)
compare_riqite(params)
}
